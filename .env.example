# Copy to .env (make init does this) and fill in. NEVER commit .env.

# --- Airflow ---
# Linux: set to the output of `id -u`. macOS/Windows (WSL2): 50000 is fine.
AIRFLOW_UID=50000
# make init generates these two
FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change-me

# --- Data lake (MinIO, S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-please
# The pipeline uses these (dev: same as root; production: a separate least-privilege user)
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-please
AWS_DEFAULT_REGION=us-east-1
LAKE_BUCKET=pm25-lake

# --- Data warehouse (PostgreSQL) ---
DWH_USER=dwh
DWH_PASSWORD=change-me-too
DWH_DB=pm25
DWH_DSN=postgresql://dwh:change-me-too@postgres-dwh:5432/pm25

# --- External APIs ---
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# https://explore.openaq.org/register  (only needed for the location list; the S3 archive needs no key)
OPENAQ_API_KEY=
# Identify ourselves politely to public APIs
HTTP_USER_AGENT=pm25-thailand-student-pipeline/0.1 (university project; contact: your-email@example.com)
